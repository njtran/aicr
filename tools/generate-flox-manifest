# =============================================================================
# Interactive Flox Package Installation
# =============================================================================
#
# This script interactively installs development tools via Flox:
#   1. Reads tool requirements from .versions.yaml
#   2. Checks what's already installed via 'flox list'
#   3. Searches for missing packages via 'flox search'
#   4. Presents options to user and installs on confirmation
#
# Usage:
#   ./tools/generate-flox-manifest           # Interactive mode
#   AUTO_MODE=true ./tools/generate-flox-manifest  # Auto-select first result
#   make flox-manifest
#
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/common
. "${SCRIPT_DIR}/common"

# Auto mode: skip prompts and auto-select first search result
AUTO_MODE=${AUTO_MODE:-false}

# =============================================================================
# Package Mapping
# =============================================================================
# Format: "yaml_key|cli_command|nix_pkg_primary"
# yaml_key: path in .versions.yaml (use _ for nested keys)
# cli_command: command name to check if tool works
# nix_pkg_primary: primary Nix package name to search

PACKAGE_MAP=(
    "languages.go|go|go"
    "testing_tools.kubectl|kubectl|kubectl"
    "testing_tools.kind|kind|kind"
    "testing_tools.helm|helm|kubernetes-helm"
    "testing_tools.tilt|tilt|tilt"
    "testing_tools.ctlptl|ctlptl|ctlptl"
    "build_tools.ko|ko|ko"
    "build_tools.goreleaser|goreleaser|goreleaser"
    "build_tools.crane|crane|crane"
    "build_tools.git_cliff|git-cliff|git-cliff"
    "linting.golangci_lint|golangci-lint|golangci-lint"
    "linting.yamllint|yamllint|yamllint"
    "linting.addlicense|addlicense|addlicense"
    "linting.go_licenses|go-licenses|go-licenses"
    "security_tools.grype|grype|grype"
)

# Additional utilities not in .versions.yaml but useful for development
EXTRA_PACKAGES=(
    "yq|yq|yq-go"
    "jq|jq|jq"
    "curl|curl|curl"
)

# =============================================================================
# Functions
# =============================================================================

# Get installed packages as associative array-like output
# Returns lines of: id|pkg-path|version
get_installed_packages() {
    # flox list output: "id: pkg-path (version)"
    # Parse "go: go (1.25.5)" -> "go|go|1.25.5"
    flox list 2>/dev/null | sed -n 's/^\([^:]*\): \([^ ]*\) (\([^)]*\))$/\1|\2|\3/p'
}

# Check if a package is installed by its ID
# Args: $1 = package id to check, $2 = installed packages (newline-separated)
is_installed() {
    local pkg_id="$1"
    local installed="$2"
    echo "$installed" | grep -q "^${pkg_id}|"
}

# Search for a package and return results
# Args: $1 = search query
# Returns: lines of "pkg-path   description"
search_package() {
    local query="$1"
    flox search "$query" 2>/dev/null | head -5
}

# Prompt user to select a package from search results
# Args: $1 = tool name, $2 = search results
# Sets SELECTED_PKG global variable with the result
# Returns: 0 if package selected, 1 if skipped/no results
prompt_package_choice() {
    local tool_name="$1"
    local results="$2"

    SELECTED_PKG=""

    # Convert results to array
    local -a options=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && options+=("$line")
    done <<< "$results"

    if [[ ${#options[@]} -eq 0 ]]; then
        return 1
    fi

    # In AUTO_MODE, auto-select first result
    if [[ "$AUTO_MODE" == "true" ]]; then
        SELECTED_PKG=$(echo "${options[0]}" | awk '{print $1}')
        log_info "AUTO_MODE: selecting '$SELECTED_PKG' for $tool_name"
        return 0
    fi

    echo ""
    echo "Select package for '$tool_name':"
    local i=1
    for opt in "${options[@]}"; do
        printf "  %d) %s\n" "$i" "$opt"
        ((i++))
    done
    printf "  s) Skip this package\n"
    echo ""

    while true; do
        printf "Enter choice [1-%d, s to skip]: " "${#options[@]}"
        read -r choice

        if [[ "$choice" == "s" || "$choice" == "S" ]]; then
            return 1
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le "${#options[@]}" ]]; then
            local selected="${options[$((choice-1))]}"
            SELECTED_PKG=$(echo "$selected" | awk '{print $1}')
            return 0
        fi

        echo "Invalid choice. Please enter 1-${#options[@]} or 's' to skip."
    done
}

# Install a package with explicit ID
# Args: $1 = package id, $2 = pkg-path
install_package() {
    local pkg_id="$1"
    local pkg_path="$2"

    log_info "Installing $pkg_id ($pkg_path)..."
    if flox install -i "$pkg_id" "$pkg_path"; then
        log_success "Installed $pkg_id"
        return 0
    else
        log_error "Failed to install $pkg_id"
        return 1
    fi
}

# Process a single package mapping
# Args: $1 = mapping string, $2 = installed packages
process_package() {
    local mapping="$1"
    local installed="$2"

    IFS='|' read -r yaml_key cli_cmd nix_pkg <<< "$mapping"

    # Check if already installed
    if is_installed "$cli_cmd" "$installed"; then
        # Get version from installed list
        local version
        version=$(echo "$installed" | grep "^${cli_cmd}|" | cut -d'|' -f3)
        log_success "$cli_cmd already installed ($version)"
        return 0
    fi

    log_info "Searching for $cli_cmd (package: $nix_pkg)..."

    # Search for package
    local results
    results=$(search_package "$nix_pkg")

    if [[ -z "$results" ]]; then
        log_warning "$cli_cmd: no results for '$nix_pkg'. Try 'flox search <query>' manually."
        return 1
    fi

    # Prompt user (or auto-select in AUTO_MODE)
    if prompt_package_choice "$cli_cmd" "$results"; then
        install_package "$cli_cmd" "$SELECTED_PKG"
    else
        log_info "Skipped $cli_cmd"
    fi
}

# =============================================================================
# Main
# =============================================================================

main() {
    log_info "Flox Package Installer for Eidos Development"
    echo ""

    # Check for flox
    if ! command -v flox &> /dev/null; then
        log_error "flox is not installed. Install from: https://flox.dev"
        exit 1
    fi

    # Get currently installed packages
    log_info "Checking installed packages..."
    local installed
    installed=$(get_installed_packages)

    if [[ -n "$installed" ]]; then
        local count
        count=$(echo "$installed" | wc -l | tr -d ' ')
        log_info "Found $count installed packages"
    else
        log_info "No packages currently installed"
    fi

    echo ""

    # Process packages from .versions.yaml
    log_info "Processing packages from .versions.yaml..."
    echo ""

    local failed=0
    for mapping in "${PACKAGE_MAP[@]}"; do
        if ! process_package "$mapping" "$installed"; then
            ((failed++)) || true
        fi
        # Refresh installed list after each install for accurate detection
        installed=$(get_installed_packages)
    done

    echo ""
    log_info "Processing extra utility packages..."
    echo ""

    for mapping in "${EXTRA_PACKAGES[@]}"; do
        if ! process_package "$mapping" "$installed"; then
            ((failed++)) || true
        fi
        installed=$(get_installed_packages)
    done

    echo ""
    if [[ $failed -gt 0 ]]; then
        log_warning "$failed package(s) were skipped or failed to install"
    fi

    log_success "Done! Run 'flox activate' to use the environment."
    echo ""
    log_info "Verify with: make tools-check"
}

main "$@"
