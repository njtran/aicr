# =============================================================================
# Interactive Flox Package Installation
# =============================================================================
#
# This script interactively installs development tools via Flox:
#   1. Reads tool requirements from .versions.yaml
#   2. Checks what's already installed via 'flox list'
#   3. Searches for missing packages via 'flox search'
#   4. Presents options to user and installs on confirmation
#
# Usage:
#   ./tools/generate-flox-manifest           # Interactive mode
#   AUTO_MODE=true ./tools/generate-flox-manifest  # Auto-select first result
#   make flox-manifest
#
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/common
. "${SCRIPT_DIR}/common"

# Auto mode: skip prompts and auto-select first search result
AUTO_MODE=${AUTO_MODE:-false}

# =============================================================================
# Package Configuration
# =============================================================================

# Packages to install (CLI command name = flox package name by default)
PACKAGES=(
    # From .versions.yaml
    go
    kubectl
    kind
    helm
    tilt
    ctlptl
    ko
    goreleaser
    crane
    git-cliff
    golangci-lint
    yamllint
    addlicense
    go-licenses
    grype
    # Extra utilities
    yq
    jq
    curl
)

# Get nix package name for a CLI command (handles overrides)
get_nix_pkg() {
    local cli_cmd="$1"
    case "$cli_cmd" in
        helm) echo "kubernetes-helm" ;;
        yq)   echo "yq-go" ;;
        *)    echo "$cli_cmd" ;;
    esac
}

# Get version constraint from .versions.yaml (uses sed/awk, no yq dependency)
# Returns version string or empty if not found
get_version() {
    local cli_cmd="$1"
    local versions_file="${REPO_ROOT}/.versions.yaml"

    [[ ! -f "$versions_file" ]] && return

    # Map CLI command to .versions.yaml key
    local yaml_key
    case "$cli_cmd" in
        go)            yaml_key="go:" ;;
        kubectl)       yaml_key="kubectl:" ;;
        kind)          yaml_key="kind:" ;;
        helm)          yaml_key="helm:" ;;
        tilt)          yaml_key="tilt:" ;;
        ctlptl)        yaml_key="ctlptl:" ;;
        ko)            yaml_key="ko:" ;;
        goreleaser)    yaml_key="goreleaser:" ;;
        crane)         yaml_key="crane:" ;;
        git-cliff)     yaml_key="git_cliff:" ;;
        golangci-lint) yaml_key="golangci_lint:" ;;
        yamllint)      yaml_key="yamllint:" ;;
        addlicense)    yaml_key="addlicense:" ;;
        go-licenses)   yaml_key="go_licenses:" ;;
        grype)         yaml_key="grype:" ;;
        *)             return ;;  # No version constraint for extras (yq, jq, curl)
    esac

    # Extract full version, strip quotes and 'v' prefix
    grep "$yaml_key" "$versions_file" | head -1 | awk '{print $2}' | tr -d "'" | sed 's/^v//'
}

# =============================================================================
# Functions
# =============================================================================

# Get installed packages as associative array-like output
# Returns lines of: id|pkg-path|version
get_installed_packages() {
    # flox list output: "id: pkg-path (version)"
    # Parse "go: go (1.25.5)" -> "go|go|1.25.5"
    flox list 2>/dev/null | sed -n 's/^\([^:]*\): \([^ ]*\) (\([^)]*\))$/\1|\2|\3/p'
}

# Check if a package is installed by its ID
# Args: $1 = package id to check, $2 = installed packages (newline-separated)
is_installed() {
    local pkg_id="$1"
    local installed="$2"
    echo "$installed" | grep -q "^${pkg_id}|"
}

# Search for a package and return results
# Args: $1 = search query
# Returns: lines of "pkg-path   description"
search_package() {
    local query="$1"
    flox search "$query" 2>/dev/null | head -5
}

# Prompt user to select a package from search results
# Args: $1 = tool name, $2 = search results
# Sets SELECTED_PKG global variable with the result
# Returns: 0 if package selected, 1 if skipped/no results
prompt_package_choice() {
    local tool_name="$1"
    local results="$2"

    SELECTED_PKG=""

    # Convert results to array
    local -a options=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && options+=("$line")
    done <<< "$results"

    if [[ ${#options[@]} -eq 0 ]]; then
        return 1
    fi

    # In AUTO_MODE, auto-select first result
    if [[ "$AUTO_MODE" == "true" ]]; then
        SELECTED_PKG=$(echo "${options[0]}" | awk '{print $1}')
        log_info "AUTO_MODE: selecting '$SELECTED_PKG' for $tool_name"
        return 0
    fi

    echo ""
    echo "Select package for '$tool_name':"
    local i=1
    for opt in "${options[@]}"; do
        printf "  %d) %s\n" "$i" "$opt"
        ((i++))
    done
    printf "  s) Skip this package\n"
    echo ""

    while true; do
        printf "Enter choice [1-%d, s to skip]: " "${#options[@]}"
        read -r choice

        if [[ "$choice" == "s" || "$choice" == "S" ]]; then
            return 1
        fi

        if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le "${#options[@]}" ]]; then
            local selected="${options[$((choice-1))]}"
            SELECTED_PKG=$(echo "$selected" | awk '{print $1}')
            return 0
        fi

        echo "Invalid choice. Please enter 1-${#options[@]} or 's' to skip."
    done
}

# Install a package with explicit ID and optional version
# Tries versions in order of precision: exact -> major.minor -> major -> none
# Args: $1 = package id, $2 = pkg-path, $3 = version (optional)
install_package() {
    local pkg_id="$1"
    local pkg_path="$2"
    local version="${3:-}"

    if [[ -z "$version" ]]; then
        log_info "Installing $pkg_id ($pkg_path)..."
        if flox install -i "$pkg_id" "$pkg_path" 2>/dev/null; then
            log_success "Installed $pkg_id"
            return 0
        fi
        log_error "Failed to install $pkg_id"
        return 1
    fi

    # Build version variants: exact, major.minor, major
    local major_minor major
    major_minor=$(echo "$version" | cut -d. -f1,2)
    major=$(echo "$version" | cut -d. -f1)

    local -a versions=("$version")
    [[ "$major_minor" != "$version" ]] && versions+=("$major_minor")
    [[ "$major" != "$major_minor" ]] && versions+=("$major")
    versions+=("")  # fallback: no version constraint

    for v in "${versions[@]}"; do
        local install_spec="$pkg_path"
        [[ -n "$v" ]] && install_spec="${pkg_path}@${v}"

        log_info "Trying $pkg_id ($install_spec)..."
        if flox install -i "$pkg_id" "$install_spec" 2>/dev/null; then
            log_success "Installed $pkg_id ($install_spec)"
            return 0
        fi
    done

    log_error "Failed to install $pkg_id (tried all version variants)"
    return 1
}

# Process a single package
# Args: $1 = CLI command name, $2 = installed packages
process_package() {
    local cli_cmd="$1"
    local installed="$2"

    # Check if already installed
    if is_installed "$cli_cmd" "$installed"; then
        local version
        version=$(echo "$installed" | grep "^${cli_cmd}|" | cut -d'|' -f3)
        log_success "$cli_cmd already installed ($version)"
        return 0
    fi

    # Get nix package name (handles overrides like helm -> kubernetes-helm)
    local nix_pkg
    nix_pkg=$(get_nix_pkg "$cli_cmd")

    log_info "Searching for $cli_cmd..."

    # Search for package
    local results
    results=$(search_package "$nix_pkg")

    if [[ -z "$results" ]]; then
        log_warning "$cli_cmd: no results for '$nix_pkg'. Try 'flox search <query>' manually."
        return 1
    fi

    # Get version constraint from .versions.yaml
    local version
    version=$(get_version "$cli_cmd")

    # Prompt user (or auto-select in AUTO_MODE)
    if prompt_package_choice "$cli_cmd" "$results"; then
        install_package "$cli_cmd" "$SELECTED_PKG" "$version"
    else
        log_info "Skipped $cli_cmd"
    fi
}

# Update manifest.toml to add version constraint for an installed package
# Tries versions in order of precision until one is available
# Args: $1 = package id
update_package_version() {
    local pkg_id="$1"
    local manifest="${REPO_ROOT}/.flox/env/manifest.toml"

    # Get desired version from .versions.yaml
    local version
    version=$(get_version "$pkg_id")
    [[ -z "$version" ]] && return 0  # No version constraint needed

    # Check if version and pkg-group already set in manifest
    if grep -q "^${pkg_id}\.version" "$manifest" 2>/dev/null; then
        local current
        current=$(grep "^${pkg_id}\.version" "$manifest" | sed 's/.*= *"\([^"]*\)".*/\1/')
        # Also ensure pkg-group is set
        if ! grep -q "^${pkg_id}\.pkg-group" "$manifest" 2>/dev/null; then
            sed -i.bak "s/^${pkg_id}\.version = \(.*\)$/${pkg_id}.version = \1\n${pkg_id}.pkg-group = \"${pkg_id}\"/" "$manifest"
            rm -f "${manifest}.bak"
            log_success "$pkg_id: added pkg-group (version $current already set)"
        else
            log_success "$pkg_id already has version constraint ($current)"
        fi
        return 0
    fi

    # Build version variants: exact, major.minor, major
    local major_minor major
    major_minor=$(echo "$version" | cut -d. -f1,2)
    major=$(echo "$version" | cut -d. -f1)

    local -a versions=("$version")
    [[ "$major_minor" != "$version" ]] && versions+=("$major_minor")
    [[ "$major" != "$major_minor" ]] && versions+=("$major")

    # Get available versions via flox show
    local nix_pkg
    nix_pkg=$(get_nix_pkg "$pkg_id")

    local available
    available=$(flox show "$nix_pkg" 2>/dev/null | grep "@" | awk '{print $1}' | sed "s/^${nix_pkg}@//")

    for v in "${versions[@]}"; do
        log_info "Checking if $pkg_id@$v is available..."
        # Check if any available version starts with this prefix
        if echo "$available" | grep -q "^${v}"; then
            # Add version and pkg-group lines after pkg-path line
            # pkg-group isolates each package so version constraints don't conflict
            sed -i.bak "s/^${pkg_id}\.pkg-path = \(.*\)$/${pkg_id}.pkg-path = \1\n${pkg_id}.version = \"${v}\"\n${pkg_id}.pkg-group = \"${pkg_id}\"/" "$manifest"
            rm -f "${manifest}.bak"
            log_success "Added version constraint: $pkg_id@$v (pkg-group: $pkg_id)"
            return 0
        fi
    done

    log_warning "$pkg_id: no available version matches .versions.yaml ($version)"
    return 1
}

# =============================================================================
# Main
# =============================================================================

main() {
    log_info "Flox Package Installer for Eidos Development"
    echo ""

    # Check for flox
    if ! command -v flox &> /dev/null; then
        log_error "flox is not installed. Install from: https://flox.dev"
        exit 1
    fi

    # Get currently installed packages
    log_info "Checking installed packages..."
    local installed
    installed=$(get_installed_packages)

    if [[ -n "$installed" ]]; then
        local count
        count=$(echo "$installed" | wc -l | tr -d ' ')
        log_info "Found $count installed packages"
    else
        log_info "No packages currently installed"
    fi

    echo ""

    local failed=0
    for pkg in "${PACKAGES[@]}"; do
        if ! process_package "$pkg" "$installed"; then
            ((failed++)) || true
        fi
        # Refresh installed list after each install for accurate detection
        installed=$(get_installed_packages)
    done

    echo ""
    log_info "Updating version constraints in manifest..."
    echo ""

    for pkg in "${PACKAGES[@]}"; do
        if is_installed "$pkg" "$installed"; then
            update_package_version "$pkg" || true
        fi
    done

    echo ""
    if [[ $failed -gt 0 ]]; then
        log_warning "$failed package(s) were skipped or failed to install"
    fi

    log_success "Done! Run 'flox activate' to use the environment."
    echo ""
    log_info "Verify with: make tools-check"
}

main "$@"
